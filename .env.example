# Copy to .env and fill in real values

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_TOPIC="telemetry/#"
MQTT_CLIENT_ID="cat-ingestion"

ML_SERVER_URL="http://localhost:8000"

NODE_ENV="development"
LOG_LEVEL="info"

# Redis pub/sub (ingestion → anomaly detector)
# docker-compose maps container :6379 → host :6380
REDIS_URL="redis://localhost:6380/0"
REDIS_TELEMETRY_CHANNEL="telemetry:events"

# Demand forecasting demo/runtime
ENVIRONMENT="development"
DEMAND_DATA_MODE="synthetic"
DEMAND_DEMO_AUTH_ENABLED="true"
DEMAND_SYNTHETIC_SEED="20260730"

# Notifications / email (SMTP optional — without host, emails are logged)
FRONTEND_PUBLIC_URL="http://localhost:5173"
RENTAL_ENDING_SOON_DAYS="3"
EMAIL_ENABLED="true"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@cat-rental.local"
SMTP_USE_TLS="true"
