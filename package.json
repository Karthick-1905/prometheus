{
  "name": "cat-smart-rental",
  "version": "0.1.0",
  "private": true,
  "description": "CAT Smart Rental Tracking — MQTT ingestion, hybrid anomaly detection (rules + Python Isolation Forest), Next.js dashboard",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"NEXT,INGEST\" -c \"cyan,yellow\" \"npm run dev:next\" \"npm run dev:ingest\"",
    "dev:next": "next dev",
    "dev:ingest": "tsx src/index.ts",
    "build": "next build",
    "start": "next start",
    "ingest": "tsx src/index.ts",
    "lint": "eslint",

    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed-rental-data.ts",

    "ml:generate": "python python-ml/generate_training_data.py --n 15000",
    "ml:train": "python python-ml/train_and_eval.py --n 15000",
    "ml:server": "python python-ml/main.py",
    "ml:test": "python python-ml/test_predict_api.py",

    "sim:mqtt": "node pipeline/publish_telemetry.js",
    "sim:python": "python scripts/simulator.py",
    "data:telemetry": "node scripts/generate_data.js",

    "test:payloads": "tsx tests/test-payloads.ts",
    "test:if-legacy": "tsx scripts/test_isolation_forest.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.7",
    "mqtt": "^5.10.3",
    "next": "16.2.12",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.14",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
