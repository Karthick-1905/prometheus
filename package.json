{
  "name": "prometheus-ingestion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"NEXT,INGEST\" -c \"cyan,yellow\" \"npm run dev:next\" \"npm run dev:ingest\"",
    "dev:next": "next dev",
    "dev:ingest": "tsx src/index.ts",
    "build": "next build",
    "start": "next start",
    "ingest": "tsx src/index.ts",
    "test:payloads": "tsx tests/test-payloads.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "dotenv": "^16.4.7",
    "mqtt": "^5.10.3",
    "next": "16.2.12",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.14",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}